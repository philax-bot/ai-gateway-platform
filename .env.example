SERVICE_TOKEN=local-service-token
# Bounded, service-token-only PostgreSQL timings for controlled diagnosis.
CONTROL_PLANE_DIAGNOSTICS=false
CONTROL_PLANE_URL=http://127.0.0.1:4001
MODEL_URL=http://127.0.0.1:4010

# Optional OTLP/HTTP JSON collector; unset means no external trace export.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Managed upstream credentials. pnpm dev reuses a protected local key file.
# Production and restoration require the same 32-byte base64 key.
PLATFORM_CREDENTIAL_ENCRYPTION_KEY=
# Webhook channels reference NOTIFICATION_ variables. Use at least 32 bytes.
NOTIFICATION_ALERT_SIGNING_KEY=
