# Copy to deploy/runtime.env; keep this private file out of source control.
PUBLIC_ORIGIN=https://atlas.example.com:8443
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
DATABASE_URL=postgresql://atlas:<url-encoded-password>@<database-host>:5432/atlas
DATABASE_SCHEMA=signal_atlas
SERVICE_TOKEN=replace-with-an-independent-random-secret-at-least-32-characters
BOOTSTRAP_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
# Set true only when connecting the intended model service is authorized.
ALLOW_UPSTREAM_VALIDATION=false
ALLOW_UPSTREAM_REQUESTS=false
# Milliseconds: total deadline, first response byte, and response inactivity.
UPSTREAM_TIMEOUT_MS=600000
UPSTREAM_FIRST_BYTE_TIMEOUT_MS=120000
UPSTREAM_IDLE_TIMEOUT_MS=60000
# Drain in-flight requests, then allow 5s for settlement; Compose must allow more.
GATEWAY_DRAIN_TIMEOUT_MS=35000
GATEWAY_STOP_GRACE_PERIOD=45s
# Optional absolute path to a private file containing literal UPSTREAM_* values.
# UPSTREAM_ENV_FILE=/srv/signal-atlas/upstreams.env
# Absolute host directory containing fullchain.pem and privkey.pem; readable by container UID 101.
TLS_DIRECTORY=/srv/signal-atlas/tls
# Existing host directory for operations-container backup bundles; writable by UID 1000.
BACKUP_DIRECTORY=/srv/signal-atlas/backups
# After restoring into a new journal volume, set the path printed in the operations guide.
# GATEWAY_JOURNAL_PATH=/var/lib/signal-atlas/journal/restored/gateway-001
