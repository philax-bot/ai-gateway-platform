{
  "name": "ai-gateway-platform",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "node scripts/dev.mjs",
    "check:local": "node scripts/check-local-vertical-slice.mjs",
    "check:isolated": "pnpm build && node scripts/check-isolated.mjs",
    "check:web": "pnpm build && node scripts/check-web.mjs",
    "check:postgres": "pnpm build && node scripts/check-isolated.mjs --postgres",
    "check:monitoring": "pnpm --filter @ai-gateway/control-plane... build && node scripts/check-monitoring-pool.mjs",
    "check:load": "pnpm --filter @ai-gateway/control-plane... --filter @ai-gateway/gateway-sim... build && node scripts/check-load.mjs",
    "check:load:postgres": "pnpm --filter @ai-gateway/control-plane... --filter @ai-gateway/gateway-sim... build && node scripts/check-load.mjs --postgres",
    "check:gateway": "pnpm --filter @ai-gateway/contracts build && pnpm --filter @ai-gateway/gateway-sim test",
    "check:higress": "pnpm --filter @ai-gateway/control-plane... --filter @ai-gateway/gateway-sim... build && node --test scripts/higress/file-publisher.test.mjs && node scripts/check-higress.mjs",
    "check:delivery": "pnpm build && node scripts/check-delivery.mjs",
    "check:backup": "pnpm build && node scripts/check-delivery.mjs --backup",
    "check:containers": "node scripts/check-container.mjs",
    "check:review": "pnpm build && node scripts/check-persistent-review.mjs",
    "backup": "node scripts/backup.mjs backup",
    "restore": "node scripts/backup.mjs restore",
    "check:higress:provider": "pnpm --filter @ai-gateway/control-plane... --filter @ai-gateway/gateway-sim... build && node scripts/check-higress-provider.mjs",
    "check:higress:live": "pnpm --filter @ai-gateway/control-plane... --filter @ai-gateway/gateway-sim... build && node scripts/check-higress-live.mjs --allow-upstream",
    "check:higress:stability": "pnpm --filter @ai-gateway/control-plane... --filter @ai-gateway/gateway-sim... build && node --test scripts/higress/runtime-readiness.test.mjs && node scripts/check-higress-provider.mjs --stability",
    "check:higress:web": "pnpm --filter @ai-gateway/control-plane... --filter @ai-gateway/gateway-sim... build && node scripts/check-higress-web.mjs",
    "check:higress:business": "pnpm --filter @ai-gateway/control-plane... --filter @ai-gateway/gateway-sim... build && node scripts/check-higress-provider.mjs --business",
    "check:catalog": "pnpm build && node scripts/check-model-catalog.mjs",
    "check:guardrail": "pnpm --filter @ai-gateway/control-plane... --filter @ai-gateway/gateway-sim... build && node scripts/check-guardrail.mjs"
  }
}
